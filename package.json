{
  "name": "my-balance-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "add-format": "git add -u",
    "build:dev": "eas build --profile development",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview",
    "build:production": "eas build --profile production",
    "dev:install": "eas build --profile development --platform ios && eas device:create",
    "test:notifications": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.16",
    "@expo/ui": "~58.0.26",
    "@expo/vector-icons": "^15.0.3",
    "@infinitered/react-native-mlkit-text-recognition": "^5.0.1",
    "@react-google-maps/api": "^2.20.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@rnmapbox/maps": "^10.3.16",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "expo": "~58.0.22",
    "expo-auth-session": "~58.0.16",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-animated-numbers": "^0.6.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-places-sdk": "^0.4.0",
    "react-native-pager-view": "9.0.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "pre-commit": "^1.2.2",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3"
  },
  "pre-commit": [
    "format",
    "add-format"
  ],
  "private": true,
  "packageManager": "pnpm@9.4.0"
}
